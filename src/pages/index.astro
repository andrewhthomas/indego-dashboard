---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { LiveOverview } from "@/components/live-overview";
import { TripInsightsCard } from "@/components/trip-insights-card";
---

<DashboardLayout>
  <div class="flex flex-col gap-6">
    <div>
      <h2 class="text-3xl font-bold tracking-tight">Overview</h2>
      <p class="text-muted-foreground">
        Philadelphia bike share system analytics and insights
      </p>
    </div>

    <LiveOverview client:load />

    <TripInsightsCard />
  </div>
</DashboardLayout>
