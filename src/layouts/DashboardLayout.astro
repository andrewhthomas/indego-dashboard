---
import "@fontsource-variable/inter";
import "@fontsource-variable/geist-mono";
import "@/styles/global.css";
import { Header } from "@/components/header";

interface Props {
  title?: string;
}

const { title } = Astro.props;
// Prerendered paths can carry a trailing slash or .html; nav hrefs have neither.
const pathname = Astro.url.pathname.replace(/(\/?index\.html|\.html|\/)$/, "") || "/";
const pageTitle = title
  ? `${title} | Indego Bike Dashboard`
  : "Indego Bike Dashboard";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Philadelphia bike share data visualization dashboard"
    />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        const dark =
          theme === "dark" ||
          (theme !== "light" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.style.colorScheme = dark ? "dark" : "light";
      })();
    </script>
  </head>
  <body>
    <div class="min-h-screen bg-background">
      <Header client:load pathname={pathname} />
      <main class="container mx-auto px-4 py-6 md:px-6 lg:px-8">
        <slot />
      </main>
    </div>
  </body>
</html>
