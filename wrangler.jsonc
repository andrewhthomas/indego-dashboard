{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "indego-dashboard",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
}
