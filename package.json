    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@types/leaflet": "^1.9.20",
    "astro": "^7.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.13.0",
    "radix-ui": "^1.7.0",
    "react": "19.1.0",
